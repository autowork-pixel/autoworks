@@ -0,0 +1,42 @@
+name: Deploy Firebase Hosting and rules
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  id-token: write
+
+concurrency:
+  group: firebase-production
+  cancel-in-progress: false
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    environment: production
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci
+      - run: npm run test:html
+      - run: npm run test:links
+      - run: npm run test:security
+      - name: Authenticate to Google Cloud
+        uses: google-github-actions/auth@v2
+        with:
+          workload_identity_provider: projects/823085494995/locations/global/workloadIdentityPools/github-actions/providers/github
+          service_account: autoworks-github-deploy@autoworks-c9a6a.iam.gserviceaccount.com
+      - name: Deploy Hosting and Firestore rules
+        run: npx --yes firebase-tools@15.34.2 deploy --project autoworks-c9a6a --only hosting,firestore:rules --non-interactive
+      - name: Verify deployed Hosting
+        run: |
+          for attempt in 1 2 3 4 5 6; do
+            npm run verify:hosting && exit 0
+            sleep 5
+          done
+          exit 1
