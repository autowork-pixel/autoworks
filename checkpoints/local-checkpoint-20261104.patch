+});
+
+test("API 오류 본문과 키는 고객 오류에 노출하지 않는다", async () => {
+  const secret = "youtube-secret-key";
+  await assert.rejects(() => fetchVideoPerformance({ credentials: { apiKey: secret }, ...context, fetchImpl: async url => {
+    assert.equal(String(url).includes(secret), true);
+    return { ok: false, status: 403 };
+  } }), error => error.code === "PROVIDER_AUTH_FAILED" && !error.message.includes(secret));
+});
+
+test("최근 인기 영상 검색 결과에 출처와 참여율을 보존한다", async () => {
+  const calls = [];
+  const result = await searchContentReferences({
+    credentials: { apiKey: "secret" },
+    input: { brand: "오토웍스", category: "마케팅", keywords: ["자동화"], periodDays: 28, collectCount: 5 },
+    now: () => new Date("2026-11-03T00:00:00Z"),
+    fetchImpl: async url => {
+      calls.push(new URL(url));
+      if (calls.length === 1) return { ok: true, json: async () => ({ items: [{ id: { videoId: context.videoId } }] }) };
+      return { ok: true, json: async () => ({ items: [{ id: context.videoId, snippet: { title: "레퍼런스", channelTitle: "채널", publishedAt: "2026-11-01T00:00:00Z" }, statistics: { viewCount: "100", likeCount: "8", commentCount: "2" } }] }) };
+    }
+  });
+  assert.equal(calls[0].pathname.endsWith("/search"), true);
+  assert.equal(calls[0].searchParams.get("order"), "viewCount");
+  assert.equal(result.rows[0].sourceUrl, `https://www.youtube.com/watch?v=${context.videoId}`);
+  assert.equal(result.rows[0].engagementRate, 10);
+});
+
+test("공개 채널을 구독자 범위로 거르고 연락처를 추정하지 않는다", async () => {
+  let call = 0;
+  const result = await searchInfluencerCandidates({ credentials: { apiKey: "secret" }, input: { brand: "오토웍스", keywords: ["마케팅"], subscriberMin: 1000, subscriberMax: 100000, candidateCount: 5 }, fetchImpl: async () => {
+    call += 1;
+    if (call === 1) return { ok: true, json: async () => ({ items: [{ id: { channelId: "channel-a" } }] }) };
+    return { ok: true, json: async () => ({ items: [{ id: "channel-a", snippet: { title: "채널", description: "소개", thumbnails: {} }, statistics: { subscriberCount: "12000", videoCount: "30", viewCount: "900000" } }] }) };
+  } });
+  assert.equal(result.rows[0].subscriberCount, 12000);
+  assert.equal(result.rows[0].contactStatus.includes("이메일"), true);
+  assert.equal(JSON.stringify(result).includes("@"), false);
+});
