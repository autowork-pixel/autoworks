+++ b/server/src/youtube-data.mjs
@@ -0,0 +1,113 @@
+import { ApiError } from "./domain.mjs";
+
+function count(value) {
+  if (value == null) return null;
+  const number = Number(value);
+  return Number.isSafeInteger(number) && number >= 0 ? number : null;
+}
+
+export function mapYouTubeVideoResponse(payload, { videoId, postUrl, recordedAt = new Date() }) {
+  const item = Array.isArray(payload?.items) ? payload.items.find(value => value?.id === videoId) : null;
+  if (!item) throw new ApiError("PROVIDER_NO_DATA", "공개 영상 정보를 찾을 수 없습니다.", 404);
+  if (!item.snippet || !item.statistics) throw new ApiError("PROVIDER_INVALID_RESPONSE", "영상 지표 응답 형식이 올바르지 않습니다.", 502);
+  return {
+    platform: "youtube",
+    postUrl,
+    videoId,
+    title: String(item.snippet.title || "제목 없음").slice(0, 300),
+    channelTitle: String(item.snippet.channelTitle || "채널 정보 없음").slice(0, 200),
+    publishedAt: item.snippet.publishedAt || null,
+    viewCount: count(item.statistics.viewCount),
+    likeCount: count(item.statistics.likeCount),
+    commentCount: count(item.statistics.commentCount),
+    recordedAt
+  };
+}
+
+export async function fetchVideoPerformance({ credentials, videoId, postUrl, fetchImpl = fetch, now = () => new Date() }) {
+  const apiKey = credentials?.apiKey;
+  if (typeof apiKey !== "string" || !apiKey.trim()) throw new ApiError("PROVIDER_CREDENTIAL_REQUIRED", "YouTube API 연결이 필요합니다.", 409);
+  const endpoint = new URL("https://www.googleapis.com/youtube/v3/videos");
+  endpoint.searchParams.set("part", "snippet,statistics");
+  endpoint.searchParams.set("id", videoId);
+  endpoint.searchParams.set("key", apiKey.trim());
+  let response;
+  try { response = await fetchImpl(endpoint, { headers: { accept: "application/json" } }); }
+  catch { throw new ApiError("PROVIDER_UNAVAILABLE", "YouTube API에 연결하지 못했습니다.", 503); }
+  if (!response?.ok) {
+    const status = Number(response?.status || 0);
+    if (status === 401 || status === 403) throw new ApiError("PROVIDER_AUTH_FAILED", "YouTube API 인증 또는 할당량을 확인해 주세요.", 409);
+    if (status === 404) throw new ApiError("PROVIDER_NO_DATA", "공개 영상 정보를 찾을 수 없습니다.", 404);
+    if (status === 429) throw new ApiError("PROVIDER_RATE_LIMIT", "YouTube API 요청 한도에 도달했습니다.", 429);
+    throw new ApiError("PROVIDER_UNAVAILABLE", "YouTube API가 일시적으로 응답하지 않습니다.", 503);
+  }
+  let payload;
+  try { payload = await response.json(); } catch { throw new ApiError("PROVIDER_INVALID_RESPONSE", "YouTube API 응답을 읽지 못했습니다.", 502); }
+  return mapYouTubeVideoResponse(payload, { videoId, postUrl, recordedAt: now() });
+}
+
+async function youtubeJson(endpoint, fetchImpl) {
+  let response;
+  try { response = await fetchImpl(endpoint, { headers: { accept: "application/json" } }); }
+  catch { throw new ApiError("PROVIDER_UNAVAILABLE", "YouTube API에 연결하지 못했습니다.", 503); }
+  if (!response?.ok) {
+    const status = Number(response?.status || 0);
+    if (status === 401 || status === 403) throw new ApiError("PROVIDER_AUTH_FAILED", "YouTube API 인증 또는 할당량을 확인해 주세요.", 409);
+    if (status === 429) throw new ApiError("PROVIDER_RATE_LIMIT", "YouTube API 요청 한도에 도달했습니다.", 429);
+    throw new ApiError("PROVIDER_UNAVAILABLE", "YouTube API가 일시적으로 응답하지 않습니다.", 503);
+  }
+  try { return await response.json(); }
+  catch { throw new ApiError("PROVIDER_INVALID_RESPONSE", "YouTube API 응답을 읽지 못했습니다.", 502); }
+}
+
+export async function searchContentReferences({ credentials, input, fetchImpl = fetch, now = () => new Date() }) {
+  const apiKey = credentials?.apiKey;
+  if (typeof apiKey !== "string" || !apiKey.trim()) throw new ApiError("PROVIDER_CREDENTIAL_REQUIRED", "YouTube API 연결이 필요합니다.", 409);
+  const recordedAt = now();
+  const publishedAfter = new Date(recordedAt.getTime() - input.periodDays * 86_400_000).toISOString();
+  const query = [input.brand, input.category, ...input.keywords].join(" ").slice(0, 500);
+  const searchEndpoint = new URL("https://www.googleapis.com/youtube/v3/search");
+  for (const [key, value] of Object.entries({ part: "snippet", type: "video", order: "viewCount", maxResults: String(input.collectCount), q: query, publishedAfter, regionCode: "KR", relevanceLanguage: "ko", safeSearch: "moderate", key: apiKey.trim() })) searchEndpoint.searchParams.set(key, value);
+  const searchPayload = await youtubeJson(searchEndpoint, fetchImpl);
+  const videoIds = (Array.isArray(searchPayload?.items) ? searchPayload.items : []).map(item => item?.id?.videoId).filter(id => /^[A-Za-z0-9_-]{11}$/.test(id)).slice(0, input.collectCount);
+  if (!videoIds.length) throw new ApiError("PROVIDER_NO_DATA", "조건에 맞는 공개 영상을 찾지 못했습니다.", 404);
+  const videosEndpoint = new URL("https://www.googleapis.com/youtube/v3/videos");
+  for (const [key, value] of Object.entries({ part: "snippet,statistics", id: videoIds.join(","), key: apiKey.trim() })) videosEndpoint.searchParams.set(key, value);
+  const videosPayload = await youtubeJson(videosEndpoint, fetchImpl);
+  const rows = videoIds.map(videoId => mapYouTubeVideoResponse(videosPayload, { videoId, postUrl: `https://www.youtube.com/watch?v=${videoId}`, recordedAt })).map(item => ({
+    ...item,
+    sourceUrl: item.postUrl,
+    thumbnailUrl: `https://i.ytimg.com/vi/${item.videoId}/hqdefault.jpg`,
+    engagementRate: item.viewCount && item.likeCount != null && item.commentCount != null ? Number((((item.likeCount + item.commentCount) / item.viewCount) * 100).toFixed(2)) : null
+  }));
+  return { query, publishedAfter, recordedAt, rows };
+}
+
+export async function searchInfluencerCandidates({ credentials, input, fetchImpl = fetch, now = () => new Date() }) {
+  const apiKey = credentials?.apiKey;
+  if (typeof apiKey !== "string" || !apiKey.trim()) throw new ApiError("PROVIDER_CREDENTIAL_REQUIRED", "YouTube API 연결이 필요합니다.", 409);
+  const recordedAt = now();
+  const query = [input.brand, ...input.keywords].join(" ").slice(0, 500);
+  const searchEndpoint = new URL("https://www.googleapis.com/youtube/v3/search");
+  for (const [key, value] of Object.entries({ part: "snippet", type: "channel", maxResults: "50", q: query, regionCode: "KR", relevanceLanguage: "ko", safeSearch: "moderate", key: apiKey.trim() })) searchEndpoint.searchParams.set(key, value);
+  const searchPayload = await youtubeJson(searchEndpoint, fetchImpl);
+  const channelIds = [...new Set((Array.isArray(searchPayload?.items) ? searchPayload.items : []).map(item => item?.id?.channelId).filter(id => typeof id === "string" && id.length <= 128))];
+  if (!channelIds.length) throw new ApiError("PROVIDER_NO_DATA", "조건에 맞는 공개 채널을 찾지 못했습니다.", 404);
+  const channelsEndpoint = new URL("https://www.googleapis.com/youtube/v3/channels");
+  for (const [key, value] of Object.entries({ part: "snippet,statistics", id: channelIds.join(","), key: apiKey.trim() })) channelsEndpoint.searchParams.set(key, value);
+  const channelsPayload = await youtubeJson(channelsEndpoint, fetchImpl);
+  const rows = (Array.isArray(channelsPayload?.items) ? channelsPayload.items : []).map(item => {
+    const hidden = item?.statistics?.hiddenSubscriberCount === true;
+    const subscribers = hidden ? null : count(item?.statistics?.subscriberCount);
+    return {
+      platform: "youtube", channelId: String(item?.id || ""), channelTitle: String(item?.snippet?.title || "제목 없음").slice(0, 200),
+      description: String(item?.snippet?.description || "").slice(0, 1000), channelUrl: `https://www.youtube.com/channel/${encodeURIComponent(String(item?.id || ""))}`,
+      thumbnailUrl: item?.snippet?.thumbnails?.medium?.url || item?.snippet?.thumbnails?.default?.url || null,
+      subscriberCount: subscribers, subscriberCountHidden: hidden, videoCount: count(item?.statistics?.videoCount), viewCount: count(item?.statistics?.viewCount),
+      contactStatus: "YouTube 공개 API는 이메일을 제공하지 않음", recordedAt
+    };
+  }).filter(item => item.channelId && item.subscriberCount != null && item.subscriberCount >= input.subscriberMin && item.subscriberCount <= input.subscriberMax)
+    .sort((a, b) => b.subscriberCount - a.subscriberCount).slice(0, input.candidateCount);
+  if (!rows.length) throw new ApiError("PROVIDER_NO_DATA", "구독자 범위에 맞는 공개 채널을 찾지 못했습니다.", 404);
+  return { query, recordedAt, rows };
+}
