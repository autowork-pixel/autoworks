@@ -0,0 +1,61 @@
+import { createHash } from "node:crypto";
+import readXlsxFile from "read-excel-file/node";
+import { ApiError } from "./domain.mjs";
+
+const aliases = Object.freeze({
+  campaign: ["캠페인", "캠페인명", "campaign", "campaign name"],
+  impressions: ["노출", "노출수", "impressions"],
+  clicks: ["클릭", "클릭수", "clicks"],
+  cost: ["비용", "광고비", "지출", "cost", "spend"],
+  conversions: ["전환", "전환수", "conversions"],
+  revenue: ["매출", "전환매출", "revenue", "sales"]
+});
+
+function header(value) { return String(value ?? "").trim().toLocaleLowerCase("ko-KR"); }
+function number(value, field, rowNumber) {
+  if (value === "" || value == null) return 0;
+  const parsed = typeof value === "number" ? value : Number(String(value).replaceAll(",", "").replace(/[₩원\s]/g, ""));
+  if (!Number.isFinite(parsed) || parsed < 0) throw new ApiError("INVALID_INPUT", `${rowNumber}행의 ${field} 값이 올바르지 않습니다.`);
+  return parsed;
+}
+function indexMap(headers) {
+  const normalized = headers.map(header), result = {};
+  for (const [field, names] of Object.entries(aliases)) result[field] = normalized.findIndex(value => names.includes(value));
+  for (const required of ["campaign", "impressions", "clicks", "cost"]) if (result[required] < 0) throw new ApiError("INVALID_INPUT", `필수 열이 없습니다: ${aliases[required][0]}`);
+  return result;
+}
+
+export async function parseWeeklyAdWorkbook({ fileName, fileBase64 }) {
+  if (typeof fileName !== "string" || !/^[^\\/:*?"<>|]{1,120}\.xlsx$/i.test(fileName.trim())) throw new ApiError("INVALID_INPUT", "2MB 이하의 .xlsx 파일만 업로드할 수 있습니다.");
+  if (typeof fileBase64 !== "string" || !/^[A-Za-z0-9+/]+={0,2}$/.test(fileBase64)) throw new ApiError("INVALID_INPUT", "Excel 파일 형식이 올바르지 않습니다.");
+  const buffer = Buffer.from(fileBase64, "base64");
+  if (!buffer.length || buffer.length > 2 * 1024 * 1024) throw new ApiError("INVALID_INPUT", "Excel 파일은 2MB 이하여야 합니다.");
+  let rows;
+  try { rows = await readXlsxFile(buffer); }
+  catch { throw new ApiError("INVALID_INPUT", "Excel 파일을 읽을 수 없습니다. 암호화되거나 손상된 파일인지 확인해 주세요."); }
+  if (!Array.isArray(rows) || rows.length < 2) throw new ApiError("INVALID_INPUT", "머리글과 데이터가 있는 첫 번째 시트가 필요합니다.");
+  if (rows.length > 501) throw new ApiError("INVALID_INPUT", "광고 데이터는 최대 500행까지 업로드할 수 있습니다.");
+  const columns = indexMap(rows[0]);
+  const normalizedRows = rows.slice(1).filter(row => Array.isArray(row) && row.some(value => value !== null && value !== "")).map((row, index) => {
+    const rowNumber = index + 2, campaign = String(row[columns.campaign] ?? "").trim();
+    if (!campaign || campaign.length > 200) throw new ApiError("INVALID_INPUT", `${rowNumber}행의 캠페인명이 올바르지 않습니다.`);
+    const item = { campaign, impressions: number(row[columns.impressions], "노출", rowNumber), clicks: number(row[columns.clicks], "클릭", rowNumber), cost: number(row[columns.cost], "비용", rowNumber) };
+    if (columns.conversions >= 0) item.conversions = number(row[columns.conversions], "전환", rowNumber);
+    if (columns.revenue >= 0) item.revenue = number(row[columns.revenue], "매출", rowNumber);
+    if (item.clicks > item.impressions) throw new ApiError("INVALID_INPUT", `${rowNumber}행은 클릭수가 노출수보다 큽니다.`);
+    return item;
+  });
+  if (!normalizedRows.length) throw new ApiError("INVALID_INPUT", "분석할 광고 데이터가 없습니다.");
+  return { fileName: fileName.trim(), fileHash: createHash("sha256").update(buffer).digest("hex"), rows: normalizedRows, hasConversions: columns.conversions >= 0, hasRevenue: columns.revenue >= 0 };
+}
+
+export function analyzeWeeklyAdRows(input, now = new Date()) {
+  const rows = input.rows.map(item => {
+    const ctr = item.impressions ? item.clicks / item.impressions : null, cpc = item.clicks ? item.cost / item.clicks : null;
+    const cvr = input.hasConversions && item.clicks ? item.conversions / item.clicks : null, cpa = input.hasConversions && item.conversions ? item.cost / item.conversions : null;
+    const roas = input.hasRevenue && item.cost ? item.revenue / item.cost : null;
+    return { ...item, ctr, cpc, cvr, cpa, roas };
+  });
+  const summary = rows.reduce((total, item) => ({ impressions: total.impressions + item.impressions, clicks: total.clicks + item.clicks, cost: total.cost + item.cost, conversions: total.conversions + Number(item.conversions || 0), revenue: total.revenue + Number(item.revenue || 0) }), { impressions: 0, clicks: 0, cost: 0, conversions: 0, revenue: 0 });
+  return { rows, summary: { ...summary, ctr: summary.impressions ? summary.clicks / summary.impressions : null, cpc: summary.clicks ? summary.cost / summary.clicks : null, cvr: input.hasConversions && summary.clicks ? summary.conversions / summary.clicks : null, cpa: input.hasConversions && summary.conversions ? summary.cost / summary.conversions : null, roas: input.hasRevenue && summary.cost ? summary.revenue / summary.cost : null }, analyzedAt: now };
+}
